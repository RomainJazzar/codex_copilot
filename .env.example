# Copy this file to .env and fill in your key. Never commit .env!

# --- Option A: OpenRouter (recommended) ---
# Create your key at: https://openrouter.ai/keys

API_KEY=API_KEY=YOUR_OPENROUTER_API_KEY
BASE_URL=https://openrouter.ai/api/v1
MODEL=z-ai/glm-5.3-flash

# Any OpenRouter model that supports tool calling can be used.
# To change model, only change the MODEL line above.


# --- Option B: OpenAI API directly ---
# Create your key at: https://platform.openai.com/api-keys

# API_KEY=sk-...
# BASE_URL=https://api.openai.com/v1
# MODEL=your-openai-model-name